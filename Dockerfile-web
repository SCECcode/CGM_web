FROM amazonlinux:2023

WORKDIR /app

COPY . /app

## php
RUN dnf upgrade -y --releasever=latest && \
    dnf install -y \
        php8.2 php8.2-cli php8.2-pgsql php8.2-fpm && \
    dnf clean all && \
    rm -rf /var/cache/dnf && \
    php -v

RUN mkdir -p /run/php-fpm && \
    chown -R apache:apache /run/php-fpm

RUN sed -i 's/^listen.acl_users =.*/;listen.acl_users =/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.owner =.*/listen.owner = apache/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.group =.*/listen.group = apache/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.mode =.*/listen.mode = 0660/' /etc/php-fpm.d/www.conf

## python/hdf5
RUN dnf install -y make yum perl libxml2-devel zip unzip && \
    dnf install -y tar wget gawk zip coreutils && \
    dnf install -y autoconf automake libtool file pkgconfig && \
    dnf install -y zlib zlib-devel && \
    dnf install -y gcc gcc-c++ gcc-gfortran binutils && \
    dnf install -y sudo which gtar openblas yum-utils && \
    dnf install -y openssl11-devel libffi-devel

