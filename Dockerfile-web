FROM amazonlinux:2023

WORKDIR /app

# 1. Install System Dependencies & Apache
RUN dnf update -y && \
    dnf install -y \
        httpd \
        php8.3 php8.3-cli php8.3-pgsql php8.3-fpm \
        make perl libxml2-devel zip unzip \
        tar wget gawk \
        autoconf automake libtool file pkgconfig \
        zlib zlib-devel \
        gcc gcc-c++ gcc-gfortran binutils \
        sudo which git \
        openssl-devel libffi-devel python3-devel && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# 2. Build and install HDF5 C library from source (required for h5py on AL2023)
RUN wget -q https://github.com/HDFGroup/hdf5/archive/refs/tags/hdf5-1_12_2.tar.gz && \
    tar -xzf hdf5-1_12_2.tar.gz && \
    cd hdf5-hdf5-1_12_2 && \
    ./configure --prefix=/usr/local/hdf5 --enable-build-mode=production && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf hdf5-1_12_2.tar.gz hdf5-hdf5-1_12_2

ENV HDF5_DIR=/usr/local/hdf5
ENV LD_LIBRARY_PATH=/usr/local/hdf5/lib:${LD_LIBRARY_PATH}

# 3. Configure PHP-FPM
RUN mkdir -p /run/php-fpm && \
    chown -R apache:apache /run/php-fpm && \
    sed -i 's/^listen.acl_users =.*/;listen.acl_users =/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.owner =.*/listen.owner = apache/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.group =.*/listen.group = apache/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;listen.mode =.*/listen.mode = 0660/' /etc/php-fpm.d/www.conf && \
    sed -i 's/^;clear_env = no/clear_env = no/' /etc/php-fpm.d/www.conf

# 4. Copy application files before compiling custom Python
COPY . /app

# 5. Compile Python 3.8.11 from source
RUN cd /app/misc && \
    tar zxvf cpython-3.8.11.tar.gz && \
    cd cpython-3.8.11 && \
    ./configure --prefix=/usr/local/python-3.8.11 && \
    make -j$(nproc) && \
    make install && \
    rm -rf /app/misc/cpython-3.8.11*

# Link custom Python executable and upgrade pip tooling
RUN ln -sf /usr/local/python-3.8.11/bin/python3.8 /usr/bin/python3 && \
    ln -sf /usr/local/python-3.8.11/bin/pip3.8 /usr/bin/pip3 && \
    python3 -m pip install --upgrade pip setuptools wheel

# 6. Install Python dependencies (h5py will now detect HDF5_DIR)
RUN HDF5_DIR=/usr/local/hdf5 python3 -m pip install --no-cache-dir numpy netCDF4 h5py

# 7. Install InSAR readers/writers library & set permissions
RUN cd /app && \
    git clone https://github.com/SCECcode/InSAR_CGM_readers_writers.git && \
    cd InSAR_CGM_readers_writers && \
    python3 setup.py install && \
    mkdir -p /app/web/result /app/web/py && \
    chmod og+rw /app/web/result && \
    chmod -R og+x /app/web/py

# 8. Configure Apache & Entrypoint
COPY ./doc/cgm.conf /etc/httpd/conf.d/

RUN printf '#!/bin/bash\nphp-fpm -D\nexec /usr/sbin/httpd -D FOREGROUND\n' > /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80

CMD ["/usr/local/bin/entrypoint.sh"]

